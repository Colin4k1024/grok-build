{
  "name": "grok-build-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "postbuild": "node scripts/check-bundle-budget.mjs dist",
    "preview": "vite preview",
    "electron:build": "bash electron/build.sh",
    "electron:dev": "npm run electron:build && concurrently -k \"npm:dev\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 NODE_ENV=development electron .\"",
    "electron:start": "npm run electron:build && electron .",
    "electron:pack": "npm run build && npm run electron:build && electron-builder",
    "release:gate": "node scripts/release-gate.mjs",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:ci": "vitest run --coverage",
    "test:evidence": "vitest run --reporter=junit --outputFile=test-results/junit.xml && vitest run --coverage",
    "evidence": "npx vitest run --reporter=junit --outputFile=test-results/junit.xml && node scripts/evidence-generator.mjs --strict",
    "evidence:generate": "node scripts/evidence-generator.mjs --strict",
    "uat:prepare": "node scripts/desktop-uat.mjs prepare",
    "uat:run": "node scripts/desktop-uat.mjs run",
    "uat:record": "node scripts/desktop-uat.mjs record",
    "uat:report": "node scripts/desktop-uat.mjs report",
    "uat:clean": "node scripts/desktop-uat.mjs clean"
  },
  "dependencies": {
    "@types/react-window": "^1.8.8",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "electron-updater": "^6.8.9",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.0",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.11",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.3",
    "react": "^18.3.1",
    "react-diff-viewer-continued": "^3.4.0",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "react-window": "^2.3.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "ws": "^8.22.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "js-yaml": "^4.3.2",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.grokbuild.desktop",
    "productName": "Grok Build",
    "artifactName": "Grok-Build-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "extraResources": [
        {
          "from": "target/release/xai-grok-pager",
          "to": "xai-grok-pager"
        },
        {
          "from": "target/release/ptyctl",
          "to": "ptyctl"
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "target/release/xai-grok-pager.exe",
          "to": "xai-grok-pager.exe"
        },
        {
          "from": "target/release/ptyctl.exe",
          "to": "ptyctl.exe"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "target/release/xai-grok-pager",
          "to": "xai-grok-pager"
        },
        {
          "from": "target/release/ptyctl",
          "to": "ptyctl"
        }
      ]
    },
    "dmg": {
      "title": "Grok Build"
    }
  }
}
