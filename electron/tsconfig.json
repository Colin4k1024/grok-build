{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "outDir": "../dist-electron",
    "types": ["node"],
    "lib": ["ES2022"]
  },
  "include": ["main.ts", "preload.ts"]
}
